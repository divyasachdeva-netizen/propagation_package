{
  "name": "CRPropa Teaching Environment",
  "dockerFile": "Dockerfile",
  "containerUser": "root",
  "forwardPorts": [8888],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "postCreateCommand": "pip install jupyterlab matplotlib numpy scipy h5py"
}
