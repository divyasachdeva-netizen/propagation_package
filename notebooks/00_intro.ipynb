print("CRPropa version:", crp.__version__)

sim = crp.ModuleList()
crp.SimplePropagation()



```python
# Create a ModuleList
sim = crp.ModuleList()

# 1. Propagation
sim.add(crp.SimplePropagation())

# 2. Interaction (use simplest: cosmological redshift)
sim.add(crp.Redshift())

# 3. Condition (stop after 20 Mpc)
sim.add(crp.MaximumTrajectoryLength(20 * crp.Mpc))

# 4. Observer
observer = crp.Observer()
observer.add(crp.ObserverPoint())   # detect photons at origin
sim.add(observer)

print("Simulation pipeline created with modules:")
for m in sim:
    print(" •", m)

src = crp.Source()
src.add(crp.SourceParticleType(crp.ParticleType.Gamma))   # γ-rays
src.add(crp.SourcePosition(crp.Vector3d(10 * crp.Mpc, 0, 0)))  # from 10 Mpc
src.add(crp.SourceEnergy(1e12 * crp.eV))  # 1 TeV γ-rays

print("Source ready.")

# Run the simulation with 5 photons
src.run(sim, 5)

print("Detected particles:")
for p in observer.getDetectedParticles():
    print(p)
